{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackproof.dev/schema/hackathon-export-1.0.json",
  "$defs": {
    "Chain": {
      "properties": {
        "contractCount": {
          "description": "Contracts deployed inside the official window",
          "title": "Contractcount",
          "type": "integer"
        },
        "wasmUploadCount": {
          "description": "Distinct wasm uploads inside the window",
          "title": "Wasmuploadcount",
          "type": "integer"
        },
        "classicOpCount": {
          "description": "Classic operations by the project's accounts",
          "title": "Classicopcount",
          "type": "integer"
        },
        "assetCount": {
          "description": "Assets issued inside the window by the project's accounts",
          "title": "Assetcount",
          "type": "integer"
        },
        "failedTxCount": {
          "description": "Failed Soroban transactions by the project's accounts",
          "title": "Failedtxcount",
          "type": "integer"
        },
        "accounts": {
          "description": "Stellar accounts attributed to the project",
          "items": {
            "type": "string"
          },
          "title": "Accounts",
          "type": "array"
        },
        "wasmHashes": {
          "description": "Wasm hashes uploaded by the project's accounts",
          "items": {
            "type": "string"
          },
          "title": "Wasmhashes",
          "type": "array"
        },
        "contracts": {
          "description": "Contracts deployed inside the window",
          "items": {
            "$ref": "#/$defs/Contract"
          },
          "title": "Contracts",
          "type": "array"
        },
        "evidence": {
          "description": "Direct repo-to-chain matches behind the tier",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "contractCount",
        "wasmUploadCount",
        "classicOpCount",
        "assetCount",
        "failedTxCount",
        "accounts",
        "wasmHashes",
        "contracts",
        "evidence"
      ],
      "title": "Chain",
      "type": "object"
    },
    "Contract": {
      "properties": {
        "contractId": {
          "description": "Soroban contract id (C...)",
          "title": "Contractid",
          "type": "string"
        },
        "deployer": {
          "description": "Stellar account (G...) that deployed the contract",
          "title": "Deployer",
          "type": "string"
        },
        "wasmHash": {
          "description": "sha256 of the contract wasm, hex",
          "title": "Wasmhash",
          "type": "string"
        },
        "deployedAt": {
          "description": "Ledger close time of the deploy, UTC",
          "format": "date-time",
          "title": "Deployedat",
          "type": "string"
        }
      },
      "required": [
        "contractId",
        "deployer",
        "wasmHash",
        "deployedAt"
      ],
      "title": "Contract",
      "type": "object"
    },
    "Contributor": {
      "properties": {
        "login": {
          "description": "GitHub login",
          "title": "Login",
          "type": "string"
        },
        "url": {
          "description": "GitHub profile url",
          "title": "Url",
          "type": "string"
        },
        "avatarUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Avatar image url",
          "title": "Avatarurl"
        },
        "contributions": {
          "description": "Commits to the default branch, as GitHub counts them",
          "title": "Contributions",
          "type": "integer"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 3166-1 alpha-2 country derived from the public GitHub location",
          "title": "Country"
        }
      },
      "required": [
        "login",
        "url",
        "avatarUrl",
        "contributions",
        "country"
      ],
      "title": "Contributor",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "kind": {
          "description": "What was matched between the repo and the chain",
          "enum": [
            "contract",
            "wasm",
            "account",
            "asset"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject": {
          "description": "The matched contract id, wasm hash, account or CODE:ISSUER",
          "title": "Subject",
          "type": "string"
        },
        "method": {
          "description": "How the match was made; every method is an exact string match",
          "enum": [
            "contract_in_repo",
            "wasm_hash_match",
            "wasm_meta",
            "deployer_in_repo",
            "asset_in_repo"
          ],
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "description": "1.0 exact, 0.95 asset, 0.9 account",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "subject",
        "method",
        "confidence"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Hackathon": {
      "properties": {
        "slug": {
          "description": "Stable identifier",
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "network": {
          "const": "testnet",
          "title": "Network",
          "type": "string"
        },
        "startsAt": {
          "description": "Official start, UTC",
          "format": "date-time",
          "title": "Startsat",
          "type": "string"
        },
        "submissionDeadline": {
          "description": "Official submission deadline, UTC",
          "format": "date-time",
          "title": "Submissiondeadline",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "name",
        "network",
        "startsAt",
        "submissionDeadline"
      ],
      "title": "Hackathon",
      "type": "object"
    },
    "Owner": {
      "properties": {
        "login": {
          "description": "GitHub login of the repo owner",
          "title": "Login",
          "type": "string"
        },
        "avatarUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Avatar image url",
          "title": "Avatarurl"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 3166-1 alpha-2 country derived from the owner's public GitHub location",
          "title": "Country"
        }
      },
      "required": [
        "login",
        "avatarUrl",
        "country"
      ],
      "title": "Owner",
      "type": "object"
    },
    "Project": {
      "properties": {
        "repoFullName": {
          "description": "GitHub owner/name; the stable key for a project",
          "title": "Repofullname",
          "type": "string"
        },
        "repoUrl": {
          "description": "GitHub url",
          "title": "Repourl",
          "type": "string"
        },
        "name": {
          "description": "Repository name",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "GitHub repo description",
          "title": "Description"
        },
        "homepage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Homepage or demo url set on the repo",
          "title": "Homepage"
        },
        "tier": {
          "description": "Evidence strength. verified: exact repo-to-chain match with activity in the window. declared: seeded, or readme or topic names the hackathon, with commits in the window. likely: Stellar dependency and commits in the window, created or Stellar added in the window. possible: Stellar dependency and at least 3 commits in the window only.",
          "enum": [
            "verified",
            "declared",
            "likely",
            "possible"
          ],
          "title": "Tier",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Primary language",
          "title": "Language"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SPDX license id",
          "title": "License"
        },
        "stars": {
          "description": "Stargazers",
          "title": "Stars",
          "type": "integer"
        },
        "forks": {
          "description": "Forks",
          "title": "Forks",
          "type": "integer"
        },
        "selfTags": {
          "description": "GitHub topics set by the team",
          "items": {
            "type": "string"
          },
          "title": "Selftags",
          "type": "array"
        },
        "stack": {
          "description": "Stellar packages the repo's manifests declare",
          "items": {
            "type": "string"
          },
          "title": "Stack",
          "type": "array"
        },
        "stackVersions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Declared version for each stack package, as written in the manifest",
          "title": "Stackversions",
          "type": "object"
        },
        "repoCreatedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Repo creation time, UTC",
          "title": "Repocreatedat"
        },
        "repoLastCommitAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last push to the repo, UTC",
          "title": "Repolastcommitat"
        },
        "commitsInWindow": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Commits inside the official window",
          "title": "Commitsinwindow"
        },
        "totalCommits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Commits on the default branch",
          "title": "Totalcommits"
        },
        "createdDuringHack": {
          "description": "Repo was created inside the window",
          "title": "Createdduringhack",
          "type": "boolean"
        },
        "stellarAddedDuringHack": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "A Stellar dependency was absent before the window and present after",
          "title": "Stellaraddedduringhack"
        },
        "mentionsHackathon": {
          "description": "Readme or topics name the hackathon",
          "title": "Mentionshackathon",
          "type": "boolean"
        },
        "owner": {
          "$ref": "#/$defs/Owner"
        },
        "contributors": {
          "items": {
            "$ref": "#/$defs/Contributor"
          },
          "title": "Contributors",
          "type": "array"
        },
        "chain": {
          "$ref": "#/$defs/Chain"
        }
      },
      "required": [
        "repoFullName",
        "repoUrl",
        "name",
        "description",
        "homepage",
        "tier",
        "language",
        "license",
        "stars",
        "forks",
        "selfTags",
        "stack",
        "stackVersions",
        "repoCreatedAt",
        "repoLastCommitAt",
        "commitsInWindow",
        "totalCommits",
        "createdDuringHack",
        "stellarAddedDuringHack",
        "mentionsHackathon",
        "owner",
        "contributors",
        "chain"
      ],
      "title": "Project",
      "type": "object"
    }
  },
  "properties": {
    "schemaVersion": {
      "description": "Version of this schema",
      "title": "Schemaversion",
      "type": "string"
    },
    "generatedAt": {
      "description": "When the export was produced, UTC",
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "hackathon": {
      "$ref": "#/$defs/Hackathon"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "hackathon",
    "projects"
  ],
  "title": "HackathonExport",
  "type": "object"
}
