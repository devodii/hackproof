# Postgres connection string. The default matches docker compose.
DATABASE_URL=postgresql://hackproof:hackproof@localhost:5440/hackproof

# One or more fine-grained, public read-only tokens, comma separated.
# Tokens from different GitHub accounts each get their own rate limit.
HACKPROOF_GITHUB_TOKEN=


# Public url of the deployed api, used by the web build when it is hosted on another domain.
VITE_API_URL=

# PostHog project key and host from the project settings. Analytics stays off without a key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
