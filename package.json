{
  "name": "hackproof",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cd apps/api && uv run fastapi dev src/hackproof/main.py",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "format": "pnpm --filter web format",
    "format:check": "pnpm --filter web format:check",
    "build:mcp": "pnpm --filter hackproof-mcp build",
    "test:mcp": "pnpm --filter hackproof-mcp test"
  }
}