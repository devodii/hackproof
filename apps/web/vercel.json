{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|slackbot|discordbot|linkedinbot|whatsapp|telegrambot|embedly|skypeuripreview|redditbot|googlebot|bingbot|applebot|pinterest|iframely|mastodon|bluesky).*"
        }
      ],
      "destination": "/api/meta?path=/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
