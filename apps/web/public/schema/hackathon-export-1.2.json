{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackproof.vercel.app/schema/hackathon-export-1.2.json",
  "$defs": {
    "Account": {
      "properties": {
        "address": {
          "description": "Stellar account (G...)",
          "title": "Address",
          "type": "string"
        },
        "explorerUrl": {
          "description": "Stellar Expert page for the account on testnet",
          "title": "Explorerurl",
          "type": "string"
        }
      },
      "required": [
        "address",
        "explorerUrl"
      ],
      "title": "Account",
      "type": "object"
    },
    "Chain": {
      "properties": {
        "contractCount": {
          "description": "Contracts deployed inside the official window",
          "title": "Contractcount",
          "type": "integer"
        },
        "wasmUploadCount": {
          "description": "Distinct wasm uploads inside the window",
          "title": "Wasmuploadcount",
          "type": "integer"
        },
        "classicOpCount": {
          "description": "Classic operations by the project's accounts",
          "title": "Classicopcount",
          "type": "integer"
        },
        "assetCount": {
          "description": "Assets issued inside the window by the project's accounts",
          "title": "Assetcount",
          "type": "integer"
        },
        "failedTxCount": {
          "description": "Failed Soroban transactions by the project's accounts",
          "title": "Failedtxcount",
          "type": "integer"
        },
        "accounts": {
          "description": "Stellar accounts attributed to the project",
          "items": {
            "$ref": "#/$defs/Account"
          },
          "title": "Accounts",
          "type": "array"
        },
        "wasmUploads": {
          "description": "Wasm uploaded by the project's accounts",
          "items": {
            "$ref": "#/$defs/WasmUpload"
          },
          "title": "Wasmuploads",
          "type": "array"
        },
        "contracts": {
          "description": "Contracts deployed inside the window",
          "items": {
            "$ref": "#/$defs/Contract"
          },
          "title": "Contracts",
          "type": "array"
        },
        "evidence": {
          "description": "Direct repo-to-chain matches behind the tier",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "contractCount",
        "wasmUploadCount",
        "classicOpCount",
        "assetCount",
        "failedTxCount",
        "accounts",
        "wasmUploads",
        "contracts",
        "evidence"
      ],
      "title": "Chain",
      "type": "object"
    },
    "Contract": {
      "properties": {
        "contractId": {
          "description": "Soroban contract id (C...)",
          "title": "Contractid",
          "type": "string"
        },
        "deployer": {
          "description": "Stellar account (G...) that deployed the contract",
          "title": "Deployer",
          "type": "string"
        },
        "wasmHash": {
          "description": "sha256 of the contract wasm, hex",
          "title": "Wasmhash",
          "type": "string"
        },
        "deployedAt": {
          "description": "Ledger close time of the deploy, UTC",
          "format": "date-time",
          "title": "Deployedat",
          "type": "string"
        },
        "ledger": {
          "description": "Ledger sequence of the deploy",
          "title": "Ledger",
          "type": "integer"
        },
        "txHash": {
          "description": "Hash of the deploy transaction",
          "title": "Txhash",
          "type": "string"
        },
        "explorerUrl": {
          "description": "Stellar Expert page for the contract on testnet",
          "title": "Explorerurl",
          "type": "string"
        },
        "txUrl": {
          "description": "Stellar Expert page for the deploy transaction",
          "title": "Txurl",
          "type": "string"
        }
      },
      "required": [
        "contractId",
        "deployer",
        "wasmHash",
        "deployedAt",
        "ledger",
        "txHash",
        "explorerUrl",
        "txUrl"
      ],
      "title": "Contract",
      "type": "object"
    },
    "Contributor": {
      "properties": {
        "login": {
          "description": "GitHub login",
          "title": "Login",
          "type": "string"
        },
        "url": {
          "description": "GitHub profile url",
          "title": "Url",
          "type": "string"
        },
        "avatarUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Avatar image url",
          "title": "Avatarurl"
        },
        "contributions": {
          "description": "Commits to the default branch, as GitHub counts them",
          "title": "Contributions",
          "type": "integer"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 3166-1 alpha-2 country derived from the public GitHub location",
          "title": "Country"
        }
      },
      "required": [
        "login",
        "url",
        "avatarUrl",
        "contributions",
        "country"
      ],
      "title": "Contributor",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "kind": {
          "description": "What was matched between the repo and the chain",
          "enum": [
            "contract",
            "wasm",
            "account",
            "asset"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject": {
          "description": "The matched contract id, wasm hash, account or CODE:ISSUER",
          "title": "Subject",
          "type": "string"
        },
        "method": {
          "description": "How the match was made; every method is an exact string match",
          "enum": [
            "contract_in_repo",
            "wasm_hash_match",
            "wasm_meta",
            "deployer_in_repo",
            "asset_in_repo"
          ],
          "title": "Method",
          "type": "string"
        },
        "explorerUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stellar Expert page for the matched item; null for a wasm hash",
          "title": "Explorerurl"
        },
        "repoFileUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "GitHub file where the match was found; null when the evidence is not in a file",
          "title": "Repofileurl"
        }
      },
      "required": [
        "kind",
        "subject",
        "method",
        "explorerUrl",
        "repoFileUrl"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Hackathon": {
      "properties": {
        "slug": {
          "description": "Stable identifier",
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "network": {
          "const": "testnet",
          "title": "Network",
          "type": "string"
        },
        "startsAt": {
          "description": "Official start, UTC",
          "format": "date-time",
          "title": "Startsat",
          "type": "string"
        },
        "submissionDeadline": {
          "description": "Official submission deadline, UTC",
          "format": "date-time",
          "title": "Submissiondeadline",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "name",
        "network",
        "startsAt",
        "submissionDeadline"
      ],
      "title": "Hackathon",
      "type": "object"
    },
    "IntegrationEvidence": {
      "properties": {
        "method": {
          "description": "How the integration was found. package: declared in a dependency manifest. endpoint: the partner's API host appears in source or config, which covers raw API use without an SDK. A mention in prose never counts.",
          "enum": [
            "package",
            "endpoint"
          ],
          "title": "Method",
          "type": "string"
        },
        "detail": {
          "description": "The matched package name or API host",
          "title": "Detail",
          "type": "string"
        },
        "repoFileUrl": {
          "description": "GitHub file where it was found",
          "title": "Repofileurl",
          "type": "string"
        }
      },
      "required": [
        "method",
        "detail",
        "repoFileUrl"
      ],
      "title": "IntegrationEvidence",
      "type": "object"
    },
    "IntegrationPartner": {
      "properties": {
        "slug": {
          "description": "Stable partner id, listed in config/integrations.yaml",
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "description": "Partner name",
          "title": "Name",
          "type": "string"
        },
        "category": {
          "description": "payments, wallets, defi or cross-chain",
          "title": "Category",
          "type": "string"
        },
        "website": {
          "description": "Partner website",
          "title": "Website",
          "type": "string"
        },
        "evidence": {
          "description": "Where the integration was found",
          "items": {
            "$ref": "#/$defs/IntegrationEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "slug",
        "name",
        "category",
        "website",
        "evidence"
      ],
      "title": "IntegrationPartner",
      "type": "object"
    },
    "Owner": {
      "properties": {
        "login": {
          "description": "GitHub login of the repo owner",
          "title": "Login",
          "type": "string"
        },
        "avatarUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Avatar image url",
          "title": "Avatarurl"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 3166-1 alpha-2 country derived from the owner's public GitHub location",
          "title": "Country"
        }
      },
      "required": [
        "login",
        "avatarUrl",
        "country"
      ],
      "title": "Owner",
      "type": "object"
    },
    "Project": {
      "properties": {
        "repoFullName": {
          "description": "GitHub owner/name; the stable key for a project",
          "title": "Repofullname",
          "type": "string"
        },
        "repoUrl": {
          "description": "GitHub url",
          "title": "Repourl",
          "type": "string"
        },
        "name": {
          "description": "Repository name",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "GitHub repo description",
          "title": "Description"
        },
        "homepage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Homepage or demo url set on the repo",
          "title": "Homepage"
        },
        "tier": {
          "description": "Evidence strength. verified: exact repo-to-chain match with activity in the window. likely: Stellar dependency and at least 5 commits in the window, created or Stellar added in the window. possible: Stellar dependency and at least 3 commits in the window only.",
          "enum": [
            "verified",
            "likely",
            "possible"
          ],
          "title": "Tier",
          "type": "string"
        },
        "track": {
          "description": "HackMeridian track, inferred from the repo's history. genesis: a product created during the hack. scale: an existing product that predates it.",
          "enum": [
            "genesis",
            "scale"
          ],
          "title": "Track",
          "type": "string"
        },
        "award": {
          "anyOf": [
            {
              "enum": [
                "first",
                "runner-up"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "HackMeridian award as announced by Build on Stellar: first, runner-up or null",
          "title": "Award"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Primary language",
          "title": "Language"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SPDX license id",
          "title": "License"
        },
        "stars": {
          "description": "Stargazers",
          "title": "Stars",
          "type": "integer"
        },
        "forks": {
          "description": "Forks",
          "title": "Forks",
          "type": "integer"
        },
        "selfTags": {
          "description": "GitHub topics set by the team",
          "items": {
            "type": "string"
          },
          "title": "Selftags",
          "type": "array"
        },
        "stack": {
          "description": "Stellar packages the repo's manifests declare",
          "items": {
            "type": "string"
          },
          "title": "Stack",
          "type": "array"
        },
        "stackVersions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Declared version for each stack package, as written in the manifest",
          "title": "Stackversions",
          "type": "object"
        },
        "repoCreatedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Repo creation time, UTC",
          "title": "Repocreatedat"
        },
        "repoLastCommitAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last push to the repo, UTC",
          "title": "Repolastcommitat"
        },
        "commitsInWindow": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Commits inside the official window",
          "title": "Commitsinwindow"
        },
        "totalCommits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Commits on the default branch",
          "title": "Totalcommits"
        },
        "integrationPartners": {
          "description": "Stellar ecosystem partners the repo integrates, from the SCF integration list",
          "items": {
            "$ref": "#/$defs/IntegrationPartner"
          },
          "title": "Integrationpartners",
          "type": "array"
        },
        "owner": {
          "$ref": "#/$defs/Owner"
        },
        "contributors": {
          "items": {
            "$ref": "#/$defs/Contributor"
          },
          "title": "Contributors",
          "type": "array"
        },
        "chain": {
          "$ref": "#/$defs/Chain"
        }
      },
      "required": [
        "repoFullName",
        "repoUrl",
        "name",
        "description",
        "homepage",
        "tier",
        "track",
        "award",
        "language",
        "license",
        "stars",
        "forks",
        "selfTags",
        "stack",
        "stackVersions",
        "repoCreatedAt",
        "repoLastCommitAt",
        "commitsInWindow",
        "totalCommits",
        "integrationPartners",
        "owner",
        "contributors",
        "chain"
      ],
      "title": "Project",
      "type": "object"
    },
    "WasmUpload": {
      "properties": {
        "wasmHash": {
          "description": "sha256 of the contract wasm, hex",
          "title": "Wasmhash",
          "type": "string"
        },
        "uploadTx": {
          "description": "Hash of the transaction that uploaded the wasm",
          "title": "Uploadtx",
          "type": "string"
        },
        "explorerUrl": {
          "description": "Stellar Expert page for the upload transaction",
          "title": "Explorerurl",
          "type": "string"
        }
      },
      "required": [
        "wasmHash",
        "uploadTx",
        "explorerUrl"
      ],
      "title": "WasmUpload",
      "type": "object"
    }
  },
  "properties": {
    "schemaVersion": {
      "description": "Version of this schema",
      "title": "Schemaversion",
      "type": "string"
    },
    "generatedAt": {
      "description": "When the export was produced, UTC",
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "hackathon": {
      "$ref": "#/$defs/Hackathon"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "hackathon",
    "projects"
  ],
  "title": "HackathonExport",
  "type": "object"
}
