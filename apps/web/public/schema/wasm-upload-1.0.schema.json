{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackproof.vercel.app/schema/wasm-upload-1.0.schema.json",
  "properties": {
    "wasm_hash": {
      "title": "Wasm Hash",
      "type": "string"
    },
    "uploader": {
      "title": "Uploader",
      "type": "string"
    },
    "tx_hash": {
      "title": "Tx Hash",
      "type": "string"
    },
    "size": {
      "title": "Size",
      "type": "integer"
    },
    "source_repo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Repo"
    },
    "full_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Full Name"
    },
    "contracts": {
      "title": "Contracts",
      "type": "integer"
    },
    "uploaded_at": {
      "format": "date-time",
      "title": "Uploaded At",
      "type": "string"
    }
  },
  "required": [
    "wasm_hash",
    "uploader",
    "tx_hash",
    "size",
    "source_repo",
    "full_name",
    "contracts",
    "uploaded_at"
  ],
  "title": "WasmUpload",
  "type": "object"
}
